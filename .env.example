# Copie ce fichier vers .env et remplis les valeurs.
# .env ne doit JAMAIS etre commite (voir .gitignore + pre-commit hook).
# N'utilise que des comptes de TEST et des donnees synthetiques.

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=<a verifier dans la console Bedrock, ne pas deviner>
FUJI_RPC_URL=<RPC public Fuji>
GUARDIAN_PRIVATE_KEY=<compte de TEST Fuji uniquement>
