# Copie ce fichier vers .env et remplis les valeurs.
# .env ne doit JAMAIS etre commite (voir .gitignore + pre-commit hook).
# N'utilise que des comptes de TEST et des donnees synthetiques.

AWS_REGION=us-east-1
# Inference profile Bedrock (API Converse, us-east-1). Choix par defaut equipe 20,
# a confirmer -> voir docs/OPEN_QUESTIONS.md. Verifie accessible sur le compte atelier.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
GUARDIAN_PRIVATE_KEY=<compte de TEST Fuji uniquement>

# monitor : adresse du contrat token ERC-20 a ecouter sur Fuji (mints = Transfer depuis 0x0).
# Vide tant qu'aucun contrat n'est deploye (voir contracts/DEPLOYMENTS.md).
# Reglages optionnels (defauts provisoires) : voir monitor/config.py.
MONITOR_TOKEN_ADDRESS=
